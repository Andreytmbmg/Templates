[Unit]
Description=CUKTECH BLE -> MQTT bridge
After=bluetooth.target network-online.target
Wants=network-online.target bluetooth.target

[Service]
# пользователь, под которым установлен мост (владелец /opt/cuktech)
User=<пользователь>
WorkingDirectory=/opt/cuktech/server
Environment=CUKTECH_CONFIG_PATH=/etc/cuktech/config.yaml
# сброс зависшего BLE-подключения (иначе зарядка не рекламирует себя и мост её не находит)
ExecStartPre=-+/usr/bin/bluetoothctl disconnect <MAC зарядки>
ExecStart=/opt/cuktech/server/.venv/bin/cuktech-server
ExecStopPost=-+/usr/bin/bluetoothctl disconnect <MAC зарядки>
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
