[Unit]
Description=Roborock -> 3D dashboard / Sprut.hub MQTT bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=roborock
Group=roborock
WorkingDirectory=/opt/roborock
Environment=HOME=/opt/roborock
Environment=PYTHONUNBUFFERED=1
# Настройки (DUID, MQTT, порты, частоты) — в /opt/roborock/roborock_svc.conf.
# Если очень нужно, любой параметр можно перекрыть здесь: Environment=RR_MQTT_HOST=...
ExecStart=/opt/roborock/venv/bin/python /opt/roborock/roborock_svc.py
Restart=always
RestartSec=20
# бережём Homebridge: низкий приоритет и жёсткие лимиты
Nice=10
CPUQuota=25%
MemoryMax=150M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/roborock
PrivateTmp=true

[Install]
WantedBy=multi-user.target
