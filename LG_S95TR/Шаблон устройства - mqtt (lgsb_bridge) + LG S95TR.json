    {
      "name": "Вход HDMI eARC",
      "type": "Switch",
      "characteristics": [
        {
          "type": "On",
          "link": [
            {
              "type": "String",
              "topicGet": "lgsb/(1)/input",
              "topicSet": "lgsb/(1)/input/set",
              "inFunc": "(value == '20')",
              "outFunc": "'20'"
            }
          ]
        }
      ]
    },
    {
      "name": "Вход HDMI",
      "type": "Switch",
      "characteristics": [
        {
          "type": "On",
          "link": [
            {
              "type": "String",
              "topicGet": "lgsb/(1)/input",
              "topicSet": "lgsb/(1)/input/set",
              "inFunc": "(value == '6')",
              "outFunc": "value ? '6' : '20'"
            }
          ]
        }
      ]
    },
    {
