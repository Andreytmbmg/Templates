[Unit]
Description=LG Soundbar MQTT bridge
After=network-online.target
Wants=network-online.target

[Service]
User=homebridge
WorkingDirectory=/opt/lgsb
# --host  — IP саундбара, --mqtt / --mqtt-port — брокер SprutHub
ExecStart=/opt/lgsb/venv/bin/python /opt/lgsb/lgsb_bridge.py --host 192.168.31.153 --mqtt 192.168.31.147 --mqtt-port 44444
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
